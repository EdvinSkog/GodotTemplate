; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ed's Template"
run/main_scene="uid://cwij3bn2l5cmq"
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=144
boot_splash/bg_color=Color(0.0836557, 0.0910739, 0.174374, 1)
boot_splash/stretch_mode=0
boot_splash/image="uid://h7lw1dm731o5"
config/icon="uid://h7lw1dm731o5"

[audio]

buses/default_bus_layout="res://src/default_bus_layout.tres"

[autoload]

Game="*res://src/global/game_autoload.tscn"
Data="*uid://bn30qajonp73d"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
Audio="*res://src/global/audio_autoload.tscn"
Player="*res://src/global/player_autoload.tscn"
Scene="*res://src/global/scene_autoload.tscn"

[debug]

gdscript/warnings/untyped_declaration=1

[dialogue_manager]

runtime/state_autoload_shortcuts=["SceneManager", "AudioManager"]
runtime/balloon_path="res://src/systems/dialogue/balloons/basic_dialogue_balloon.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="My Template"

[editor]

script/templates_search_path="res://src/tools/script_templates"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://assets/": "purple",
"res://data/": "blue",
"res://src/global/": "yellow",
"res://src/systems/": "orange",
"res://src/user_interface/": "teal"
}

[gui]

theme/custom="res://src/user_interface/main_theme.tres"

